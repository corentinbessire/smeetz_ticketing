# French translation of Dagda Smeetz.
msgid ""
msgstr ""
"Project-Id-Version: dagda_smeetz\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n>1);\n"

msgid "Dagda Smeetz"
msgstr "Dagda Smeetz"

msgid "Book Smeetz tickets from the site: a Smeetz ticket field and a button that opens the Smeetz booking widget."
msgstr "Réserver des billets Smeetz depuis le site : un champ billet Smeetz et un bouton qui ouvre le widget de réservation Smeetz."

msgid "Smeetz"
msgstr "Smeetz"

msgid "Smeetz environment and group ID for the booking widget."
msgstr "Environnement et ID de groupe Smeetz pour le widget de réservation."

msgid "Administer Smeetz"
msgstr "Administrer Smeetz"

msgid "Set the Smeetz environment and group ID."
msgstr "Définir l’environnement et l’ID de groupe Smeetz."

msgid "The group ID is a number."
msgstr "L’ID du groupe est un nombre."

msgid "Book a ticket"
msgstr "Réserver un billet"

msgctxt "Smeetz"
msgid "Smeetz ticket"
msgstr "Billet Smeetz"

msgctxt "Smeetz"
msgid "The Smeetz product a visitor books, opened in the Smeetz booking widget."
msgstr "Le produit Smeetz réservé par le visiteur, ouvert dans le widget de réservation Smeetz."

msgctxt "Smeetz"
msgid "Product ID"
msgstr "ID du produit"

msgctxt "Smeetz"
msgid "Option UUID"
msgstr "UUID de l’option"

msgctxt "Smeetz"
msgid "Availability"
msgstr "Disponibilité"

msgctxt "Smeetz"
msgid "Last availability check"
msgstr "Dernière vérification de la disponibilité"

msgctxt "Smeetz"
msgid "The Smeetz product ID is a number."
msgstr "L’ID du produit Smeetz est un nombre."

msgctxt "Smeetz"
msgid "The Smeetz option UUID looks like 1b4e28ba-2fa1-11d2-883f-0016d3cca427."
msgstr "L’UUID de l’option Smeetz a la forme 1b4e28ba-2fa1-11d2-883f-0016d3cca427."

msgctxt "Smeetz"
msgid "In the Smeetz back office, the number in the address of the product page. Content sold on the same ticket shares the same product ID."
msgstr "Dans le back-office Smeetz, le nombre dans l’adresse de la page du produit. Les contenus vendus sur le même billet partagent le même ID de produit."

msgctxt "Smeetz"
msgid "Optional. Only needed to show \"sold out\" automatically: the ID of the ticket option, from the Smeetz back office."
msgstr "Facultatif. Seulement pour afficher « complet » automatiquement : l’ID de l’option du billet, dans le back-office Smeetz."

msgctxt "Smeetz"
msgid "Smeetz booking button"
msgstr "Bouton de réservation Smeetz"

msgctxt "Smeetz"
msgid "Button label"
msgstr "Libellé du bouton"

msgctxt "Smeetz"
msgid "Date passed to Smeetz"
msgstr "Date transmise à Smeetz"

msgctxt "Smeetz"
msgid "- None: Smeetz shows every date -"
msgstr "- Aucune : Smeetz affiche toutes les dates -"

msgctxt "Smeetz"
msgid "Smeetz opens on the day of this field. It filters by day only: two sessions of the same product on the same day both appear."
msgstr "Smeetz s’ouvre sur le jour de ce champ. Il filtre par jour seulement : deux séances du même produit le même jour apparaissent toutes les deux."

msgctxt "Smeetz"
msgid "Open the widget as an overlay"
msgstr "Ouvrir le widget par-dessus la page"

msgctxt "Smeetz"
msgid "Label: @label"
msgstr "Libellé : @label"

msgctxt "Smeetz"
msgid "Date: @field"
msgstr "Date : @field"

msgctxt "Smeetz"
msgid "No date passed"
msgstr "Aucune date transmise"

msgctxt "Smeetz"
msgid "Opens inline, not as an overlay"
msgstr "S’ouvre dans la page, pas par-dessus"

msgctxt "Smeetz"
msgid "Environment"
msgstr "Environnement"

msgctxt "Smeetz"
msgid "Test (test.tracker.smeetz.com)"
msgstr "Test (test.tracker.smeetz.com)"

msgctxt "Smeetz"
msgid "Live (tracker.smeetz.com)"
msgstr "Production (tracker.smeetz.com)"

msgctxt "Smeetz"
msgid "Use Test while the site is being built. Bookings made on Test are not real."
msgstr "Utilisez Test pendant la construction du site. Les réservations faites sur Test ne sont pas réelles."

msgctxt "Smeetz"
msgid "Group ID"
msgstr "ID du groupe"

msgctxt "Smeetz"
msgid "The organiser ID in Smeetz, a number. It appears in the embed code of any Smeetz widget (gId). While it is empty, the booking buttons link to the Smeetz booking page instead of opening the widget."
msgstr "L’ID de l’organisateur dans Smeetz, un nombre. Il figure dans le code d’intégration de tout widget Smeetz (gId). Tant qu’il est vide, les boutons de réservation mènent à la page de réservation Smeetz au lieu d’ouvrir le widget."

msgctxt "Smeetz"
msgid "(opens Smeetz in a new tab)"
msgstr "(ouvre Smeetz dans un nouvel onglet)"

msgid "Sold out"
msgstr "Complet"

msgctxt "Smeetz"
msgid "Session date"
msgstr "Date de la séance"

msgctxt "Smeetz"
msgid "- None -"
msgstr "- Aucune -"

msgctxt "Smeetz"
msgid "Used by the availability sync: past content is skipped, and each item is matched to the Smeetz slot that starts at this time. Without it, an item is sold out only when every slot of its option is."
msgstr "Utilisée par la synchronisation des disponibilités : les contenus passés sont ignorés, et chaque élément est associé au créneau Smeetz qui commence à cette heure. Sans elle, un élément n’est complet que si tous les créneaux de son option le sont."

msgctxt "Smeetz"
msgid "Also write the availability to"
msgstr "Écrire aussi la disponibilité dans"

msgctxt "Smeetz"
msgid "- Nothing -"
msgstr "- Rien -"

msgctxt "Smeetz"
msgid "Optional: a list field the sync keeps in step, for a site that already shows its own status."
msgstr "Facultatif : un champ liste que la synchronisation tient à jour, pour un site qui affiche déjà son propre statut."

msgctxt "Smeetz"
msgid "Value when available"
msgstr "Valeur si disponible"

msgctxt "Smeetz"
msgid "Value when sold out"
msgstr "Valeur si complet"

msgctxt "Smeetz"
msgid "Label when sold out"
msgstr "Libellé si complet"

msgctxt "Smeetz"
msgid "Shown instead of the button when the availability sync reports the session as sold out."
msgstr "Affiché à la place du bouton quand la synchronisation indique que la séance est complète."

msgctxt "Smeetz"
msgid "Availability sync"
msgstr "Synchronisation des disponibilités"

msgctxt "Smeetz"
msgid "Check every (minutes)"
msgstr "Vérifier toutes les (minutes)"

msgctxt "Smeetz"
msgid "minutes"
msgstr "minutes"

msgctxt "Smeetz"
msgid "How often cron asks Smeetz which sessions are sold out. 0 turns the sync off. One check covers every upcoming session in a few requests."
msgstr "À quelle fréquence le cron demande à Smeetz quelles séances sont complètes. 0 désactive la synchronisation. Une vérification couvre toutes les séances à venir en quelques requêtes."

msgctxt "Smeetz"
msgid "API key"
msgstr "Clé d’API"

msgctxt "Smeetz"
msgid "Set in settings.php."
msgstr "Définie dans settings.php."

msgctxt "Smeetz"
msgid "Not set. Add $settings['dagda_smeetz']['api_key'] to settings.local.php: it is a secret and never goes in configuration."
msgstr "Non définie. Ajoutez $settings['dagda_smeetz']['api_key'] à settings.local.php : c’est un secret, il ne va jamais dans la configuration."

msgctxt "Smeetz"
msgid "Smeetz availability sync"
msgstr "Synchronisation des disponibilités Smeetz"

msgctxt "Smeetz"
msgid "No API key"
msgstr "Pas de clé d’API"

msgctxt "Smeetz"
msgid "Set $settings['dagda_smeetz']['api_key'] in settings.local.php to show sold-out sessions automatically."
msgstr "Définissez $settings['dagda_smeetz']['api_key'] dans settings.local.php pour afficher automatiquement les séances complètes."

msgctxt "Smeetz"
msgid "Never run"
msgstr "Jamais exécutée"

msgctxt "Smeetz"
msgid "Last success @ago ago, @count requests"
msgstr "Dernier succès il y a @ago, @count requêtes"

msgctxt "Smeetz"
msgid "No successful sync for a day: sold-out badges are hidden until Smeetz answers again. See the log for errors."
msgstr "Aucune synchronisation réussie depuis un jour : les mentions « complet » sont masquées jusqu’à ce que Smeetz réponde à nouveau. Voir le journal pour les erreurs."
